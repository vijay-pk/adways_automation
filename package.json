{
  "name": "course-tutor",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "test": "npm test --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "db:migrate": "npm run db:migrate --workspace server",
    "admin:create": "npm run admin:create --workspace server"
  },
  "allowScripts": {
    "@node-rs/argon2@2.2.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
