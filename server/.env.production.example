# =====================================================================
# Production environment for https://automation.adwaysacademy.com
# Copy to server/.env.production ON THE VPS ONLY (chmod 600). Never commit it.
# Every value marked <...> must be replaced. No real secrets belong in this template.
# =====================================================================
NODE_ENV=production
APP_ORIGIN=https://automation.adwaysacademy.com
LOG_LEVEL=info

# --- Supabase database (Project Settings → Database → Connect) -------------------------
# Runtime: transaction pooler (port 6543). Keep schema=tutor (created by supabase/install.sql).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=tutor&pgbouncer=true&sslmode=require&connection_limit=5
# Migrations: session pooler (port 5432). Works on IPv4-only servers, unlike db.<ref>.supabase.co.
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=tutor&sslmode=require
# Backups (pg_dump): same session pooler, without the schema parameter.
BACKUP_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Sessions ---------------------------------------------------------------------------
# 48 random characters: openssl rand -base64 36
SESSION_SECRET=<generate-a-long-random-secret>
SESSION_TTL_HOURS=8

# --- AI answer generation (Groq) ---------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=<groq-api-key>
GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
# USD per 1M tokens for cost estimates — check current Groq pricing.
AI_PRICE_INPUT_PER_M=0.59
AI_PRICE_OUTPUT_PER_M=0.79

# --- Embeddings (separate from Groq) -----------------------------------------------------
# openai_compatible works with OpenAI and any OpenAI-style /embeddings API. "none" = keyword search only.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=<embedding-api-key>
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PRICE_PER_M=0.02

# --- Transcript originals: private Supabase Storage bucket (Project Settings → API) ------
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key: server only. Never put it in the browser or in any VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=transcripts
MAX_UPLOAD_MB=25

# --- WhatsApp Business Platform / Cloud API (docs/WHATSAPP.md) --------------------------
# Meta app → WhatsApp → API Setup. Use a permanent System User token, not the 24-hour test token.
# Webhook URL: https://automation.adwaysacademy.com/api/webhooks/whatsapp (subscribe to "messages").
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Meta app → Settings → Basic → App secret. Used to verify webhook signatures.
WHATSAPP_CLOUD_APP_SECRET=
# Any long random string; enter the same value in Meta's webhook settings.
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v23.0
# Experimental WhatsApp Web sessions are stored on the wa_session volume (docker-compose.yml).

# --- Worker ------------------------------------------------------------------------------
WORKER_ENABLED=true

# --- First admin (one-time; remove both lines after `admin:create` succeeds) ------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Must stay false in production (the server refuses to start otherwise).
ENABLE_DEV_ROUTES=false
