# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=3000

# Hosted Postgres (Neon / Supabase / VPS). For poolers, DIRECT_URL must be the direct (non-pooled) URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require
# Tests use a separate schema on the same database; it is wiped by the test suite.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=tutor_test&sslmode=require

# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=
SESSION_TTL_HOURS=8
APP_ORIGIN=http://localhost:5173

# AI: "groq" or "mock" (mock needs no key; deterministic answers for development)
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
# USD per 1M tokens, used for cost estimates; check current Groq pricing.
AI_PRICE_INPUT_PER_M=0.59
AI_PRICE_OUTPUT_PER_M=0.79

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
WORKER_ENABLED=true

# Development only: enables the mock-adapter simulator endpoints. Refused in production.
ENABLE_DEV_ROUTES=false

# One-time admin bootstrap (`npm run admin:create`). Remove the password afterwards.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional: ISO timestamp written by your backup job, shown in Administration.
LAST_BACKUP_AT=
