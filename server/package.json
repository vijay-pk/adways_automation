{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:local": "node scripts/localdb.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "admin:create": "tsx src/cli/createAdmin.ts",
    "supabase:sql": "node scripts/build-supabase-sql.mjs",
    "admin:reset-password": "tsx src/cli/resetPassword.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "otplib": "^12.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "1.5.4",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-pgvector": "^0.0.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "jszip": "^3.10.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
